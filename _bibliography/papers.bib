@article{kasarda2026windfuse,
  abbr        = {AAS},
  bibtex_show = {true},
  selected    = {true},
  title       = {WindFuse: Fusing Numerical Weather Prediction and Sparse Observations into a Dense Near-Surface Wind Field over Complex Terrain},
  author      = {Kasarda, Michal and Svoboda, Tom{\'a}{\v{s}} and Zimmermann, Karel},
  year        = {2026},
  month       = {October},
  journal     = {Submitted to Advances in Atmospheric Sciences},
  pdf         = {kasarda2026_windfuse.pdf},
  note        = {Under review},
  abstract    = {Near-surface winds over complex terrain remain challenging to predict accurately because kilometre-scale numerical weather prediction (NWP) models smooth out terrain-induced flow features, including ridge acceleration, wake formation, and channelling. Downscaling methods recover finer-scale terrain effects but inherit background forecast errors, while observation-based interpolation is limited by sparse measurements. This paper introduces WindFuse, a framework that combines numerical forecasts with local observations to reconstruct wind fields over areas spanning a few kilometres. A neural-network surrogate of computational fluid dynamics (CFD) maps terrain and forecast inflow to a dense, time-averaged, three-dimensional wind field within seconds on an embedded GPU. Exploiting the surrogate's differentiability, WindFuse optimizes two inflow parameters, a wind-speed scaling factor and a wind-direction rotation, using gradient descent to minimize a three-dimensional variational (3D-Var)-type cost function balancing observational misfit against departures from the background forecast, weighted by ensemble spread. WindFuse is evaluated using synthetic CFD benchmarks, 79 days of observations from the 2017 Perdig\~{a}o field campaign, and two airborne datasets.}
}

@article{kasarda2026terrain,
  abbr        = {RAS},
  bibtex_show = {true},
  selected    = {true},
  title       = {Terrain-Aware Input Representations for Learning-Based Real-Time Wind Field Prediction},
  author      = {Kasarda, Michal and Bakhtigariev, Robert and Zimmermann, Karel},
  year        = {2026},
  month       = {May},
  journal     = {Submitted to Robotics and Autonomous Systems},
  pdf         = {kasarda2026_terrain_aware_wind_features.pdf},
  note        = {Under review},
  abstract    = {Real-time, high-resolution wind field estimation is critical for autonomous UAV operation in complex near-ground environments. We propose two complementary input features for learning-based wind prediction: a flow incidence angle feature encoding the angular relationship between the incoming wind direction and the local terrain gradient, and a polar representation providing a continuous angular encoding of wind velocity. These features are architecture-agnostic and introduce an inductive bias that improves prediction accuracy with negligible computational overhead. We evaluate the proposed features on 3DNN, FNO, U-FNO, and U-Net across CFD simulations, UAV flight trajectories, and three near-surface mast campaigns. The flow incidence angle matches or improves the baseline on essentially every metric across all four architectures and all three settings; the polar encoding delivers larger gains on CFD and on the in-distribution Perdig\~ao mast campaign but is sensitive to terrain-scale shift on the smaller Bolund and Askervein campaigns.}
}

